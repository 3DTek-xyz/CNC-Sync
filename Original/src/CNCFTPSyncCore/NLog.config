<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <!-- File Target -->
    <target xsi:type="File" name="fileTarget"
            fileName="${var:logDirectory}/CNC-FTP-SYNC-${shortdate}.log"
            layout="${longdate} ${uppercase:${level}} ${logger} ${message} ${exception:format=tostring}" 
            keepFileOpen="false"
            maxArchiveFiles="30"
            archiveEvery="Day" />

    <!-- Console Target for debugging -->
    <target xsi:type="Console" name="consoleTarget"
            layout="${time} [${uppercase:${level}}] ${message} ${exception:format=tostring}" />

    <!-- Event Log Target for Windows Service -->
    <target xsi:type="EventLog" name="eventLogTarget"
            source="GCodeSync"
            log="Application"
            layout="${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- File logging for all levels -->
    <logger name="*" minlevel="Info" writeTo="fileTarget" />
    
    <!-- Console logging for debug builds -->
    <logger name="*" minlevel="Debug" writeTo="consoleTarget" enabled="false" />
    
    <!-- Event log for errors and warnings in production -->
    <logger name="*" minlevel="Warn" writeTo="eventLogTarget" />
  </rules>
</nlog>