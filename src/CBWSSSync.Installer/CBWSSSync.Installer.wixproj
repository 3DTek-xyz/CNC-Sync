<Project Sdk="WixToolset.Sdk/5.0.1">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platform>x64</Platform>
    <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>..\..\obj\$(Configuration)\installer\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.1" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GCodeSyncGUI\GCodeSyncGUI.csproj">
      <Properties>Platform=x64</Properties>
    </ProjectReference>
    <ProjectReference Include="..\GCodeSyncService\GCodeSyncService.csproj">
      <Properties>Platform=x64</Properties>
    </ProjectReference>
    <ProjectReference Include="..\GCodeSyncCore\GCodeSyncCore.csproj">
      <Properties>Platform=x64</Properties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Wix Include="Package.wxs" />
    <Wix Include="Components.wxs" />
    <Content Include="License.rtf" />
    <Content Include="Banner.bmp" />
    <Content Include="Dialog.bmp" />
  </ItemGroup>
</Project>