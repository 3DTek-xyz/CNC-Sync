<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
  <Package Name="CBWSS-Sync"
           Manufacturer="3DTek"
           Version="1.0.0.0"
           UpgradeCode="12345678-1234-1234-1234-123456789012"
           Compressed="true"
           InstallerVersion="500">

    <SummaryInformation Description="CNC File Transfer and Processing Service"
                       Manufacturer="3DTek"
                       Keywords="CNC, File Transfer, FTP, G-Code" />

    <!-- Major upgrade configuration for automatic updates -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  AllowDowngrades="no"
                  AllowSameVersionUpgrades="no" />

    <!-- Media and cabinet configuration -->
    <Media Id="1" Cabinet="cbwss.cab" EmbedCab="true" />

    <!-- Feature tree -->
    <Feature Id="ProductFeature" Title="CBWSS-Sync Application" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="ConfigurationComponents" />
      <ComponentRef Id="ProgramMenuDir" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- WiX UI for installation wizard - simplified version -->
    <ui:WixUI Id="WixUI_Minimal" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Installation directory structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CBWSS-Sync">
        <Directory Id="ConfigFolder" Name="config" />
        <Directory Id="LogsFolder" Name="logs" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="CBWSS-Sync" />
    </StandardDirectory>

    <!-- Desktop -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- Program Menu shortcuts -->
    <Component Id="ProgramMenuDir" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="CBWSS-Sync"
                Description="CNC File Transfer and Processing Service"
                Target="[#GCodeSyncGUI.exe]"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\3DTek\CBWSS-Sync"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="ApplicationDesktopShortcut"
                Name="CBWSS-Sync"
                Description="CNC File Transfer and Processing Service"
                Target="[#GCodeSyncGUI.exe]"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\3DTek\CBWSS-Sync"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Note: Service installation will be handled manually by the user -->
    <!-- The GUI application can manage service installation/removal -->

    <!-- Properties for silent installation -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />

  </Package>
</Wix>