<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>G-Code Sync GUI</AssemblyTitle>
    <AssemblyDescription>GUI application for G-Code sync configuration and monitoring</AssemblyDescription>
    <Copyright>Copyright © 2025</Copyright>
    <Version>1.0.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="**/*.resources.dll" />
  </ItemGroup>

  <Target Name="RemoveUnnecessaryLanguageFolders" AfterTargets="Build">
    <ItemGroup>
      <UnwantedLanguageFolders Include="$(OutputPath)**" Exclude="$(OutputPath)en/**" />
      <UnwantedLanguageFolders Include="$(OutputPath)cs" />
      <UnwantedLanguageFolders Include="$(OutputPath)de" />
      <UnwantedLanguageFolders Include="$(OutputPath)es" />
      <UnwantedLanguageFolders Include="$(OutputPath)fr" />
      <UnwantedLanguageFolders Include="$(OutputPath)it" />
      <UnwantedLanguageFolders Include="$(OutputPath)ja" />
      <UnwantedLanguageFolders Include="$(OutputPath)ko" />
      <UnwantedLanguageFolders Include="$(OutputPath)pl" />
      <UnwantedLanguageFolders Include="$(OutputPath)pt-BR" />
      <UnwantedLanguageFolders Include="$(OutputPath)ru" />
      <UnwantedLanguageFolders Include="$(OutputPath)tr" />
      <UnwantedLanguageFolders Include="$(OutputPath)zh-Hans" />
      <UnwantedLanguageFolders Include="$(OutputPath)zh-Hant" />
    </ItemGroup>
    <RemoveDir Directories="@(UnwantedLanguageFolders)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GCodeSyncCore\GCodeSyncCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CustomWebView2.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\GCodeSyncCore\NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\CBWSS-Logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>