<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      
      <!-- ServiceController assembly binding redirect -->
      <dependentAssembly>
        <assemblyIdentity name="System.ServiceProcess.ServiceController"
                          publicKeyToken="b03f5f7f11d50a3a"
                          culture="neutral" />
        <bindingRedirect oldVersion="9.0.0.9" newVersion="9.0.9.0" />
      </dependentAssembly>
      
    </assemblyBinding>
    
    <!-- Additional probing paths for assembly resolution -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="." />
    </assemblyBinding>
    
    <!-- Force load correct ServiceController version -->
    <AppContextSwitchOverrides value="Switch.System.ServiceProcess.UseShellExecuteForServiceStart=false" />
  </runtime>
  
  <!-- App settings to help with assembly loading -->
  <appSettings>
    <add key="COMPLUS_Version" value="v4.0.30319" />
  </appSettings>
</configuration>