<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CNCSync.App.ViewModels"
        xmlns:core="using:CNCSync.Core.Configuration"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CNCSync.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/cnc-sync.ico"
        Width="1180"
        Height="820"
        WindowState="Maximized"
        MinWidth="980"
        MinHeight="720"
        Title="CNC Sync">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="24">
        <TabControl>
            <TabItem Header="Overview">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <Grid ColumnDefinitions="*,300" ColumnSpacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="sectionEyebrow" Text="Control Panel" />
                                    <TextBlock Text="{Binding AppTitle}" FontSize="28" FontWeight="Bold" />
                                    <TextBlock Classes="muted"
                                               Text="{Binding AppVersion, StringFormat=Version {0}}" />
                                    <TextBlock Classes="muted"
                                               Text="Monitor local export folders, optionally process them, and deliver the result to reusable destinations."
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        IsVisible="{Binding HasUpdatePrompt}"
                                        Background="#EAF3FF"
                                        BorderBrush="#B9D1F3"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="sectionEyebrow" Text="{Binding UpdatePromptTitle}" />
                                        <TextBlock Text="{Binding UpdatePromptMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Button Classes="primary"
                                                HorizontalAlignment="Left"
                                                Content="Download and Restart"
                                                Command="{Binding DownloadAndRestartUpdateCommand}"
                                                IsEnabled="{Binding CanApplyUpdate}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Classes="heroCard" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="sectionEyebrow" Text="Live Status" />
                                    <TextBlock Text="Monitoring" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MonitoringStatus, StringFormat=Status: {0}}" />
                                    <TextBlock Classes="muted" Text="{Binding ActiveMonitoringProfilesSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentTask, StringFormat=Current task: {0}}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding LastProcessingSummary}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primary" Content="Start" Command="{Binding StartMonitoringCommand}" />
                                        <Button Classes="subtle" Content="Stop" Command="{Binding StopMonitoringCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="sectionEyebrow" Text="Recovery" />
                                    <TextBlock Text="Manual Catch-Up" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="{Binding ManualActionSummary}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="180,*">
                                        <TextBlock VerticalAlignment="Center" Text="Watch Profile" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WatchProfiles}"
                                                  SelectedItem="{Binding SelectedManualWatchProfile}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WatchProfileItemViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Button Classes="primary" HorizontalAlignment="Left" Content="Catch Up Missing Files" Command="{Binding ManualProcessCommand}" />
                                    <Separator Margin="0,8,0,4" />
                                    <Grid ColumnDefinitions="180,*">
                                        <TextBlock VerticalAlignment="Center" Text="Scheduled Catch-Up" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding ScheduledCatchUpEnabled}"
                                                  Content="Retry staged items automatically" />
                                    </Grid>
                                    <Grid ColumnDefinitions="180,*"
                                          IsVisible="{Binding ScheduledCatchUpEnabled}">
                                        <TextBlock VerticalAlignment="Center" Text="Interval" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableCatchUpIntervals}"
                                                  SelectedItem="{Binding SelectedCatchUpIntervalOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CatchUpIntervalOptionViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Classes="muted" Text="{Binding ScheduledCatchUpSummary}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted"
                                               Text="Catch-up retries only files that are still staged locally. It cannot detect and reprocess files that were created while CNC Sync was not running and never made it into staging."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="App Settings">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sectionEyebrow" Text="Global" />
                                    <TextBlock Text="App Settings" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="These settings affect the whole app. Use this tab for startup behaviour, importing a settings file, and checking whether the current configuration is valid." TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="subtle" Content="Import Settings..." Click="ImportSettings_OnClick" />
                                    <Button Classes="primary" Content="Validate Settings" Command="{Binding ValidateSettingsCommand}" />
                                    <Button Classes="subtle" Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" />
                                    <Button Classes="subtle" Content="Download and Restart" Command="{Binding DownloadAndRestartUpdateCommand}" IsEnabled="{Binding CanApplyUpdate}" />
                                </StackPanel>

                                <TextBlock Classes="muted" Text="{Binding SaveMessage}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{Binding AppVersion, StringFormat=Installed version: {0}}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="App Behavior" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="220,*">
                                    <TextBlock VerticalAlignment="Center" Text="Theme" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableThemePreferences}"
                                              SelectedItem="{Binding ThemePreference}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:AppThemePreference">
                                                <TextBlock Text="{Binding ., Converter={StaticResource AppThemePreferenceDisplayConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="220,*">
                                    <TextBlock VerticalAlignment="Center" Text="Launch At Login" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LaunchAtLogin}" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*">
                                    <TextBlock VerticalAlignment="Center" Text="Start Minimized" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Validation" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ListBox Classes="validationList"
                                         Height="160"
                                         ItemsSource="{Binding ValidationErrors}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Watch Folders">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Live Rules" />
                                <TextBlock Text="Watch Folders" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="A folder watch is the live rule that watches one local folder, stages output, chooses a processing setup, and uploads to a selected destination." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="320,*">
                            <Border Classes="card" Margin="0,0,8,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Watch Profiles" FontSize="18" FontWeight="SemiBold" />
                                        <Button Classes="subtle" Content="Add" Command="{Binding AddWatchProfileCommand}" />
                                        <Button Classes="subtle" Content="Remove" Command="{Binding RemoveWatchProfileCommand}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding WatchProfiles}" SelectedItem="{Binding SelectedWatchProfile}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WatchProfileItemViewModel">
                                                <StackPanel Margin="0,4,0,4" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding WatchFolder}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Selected Watch Profile" FontSize="18" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Profile Name" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedWatchProfile.Name, UpdateSourceTrigger=LostFocus}" Watermark="Kitchen Router Jobs" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Enabled" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedWatchProfile.Enabled}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Watch Folder" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding SelectedWatchProfile.WatchFolder, UpdateSourceTrigger=LostFocus}" Watermark="Folder to monitor" />
                                            <Button Grid.Column="1" Content="Browse..." Click="BrowseWatchFolder_OnClick" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Staging Folder" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding SelectedWatchProfile.StagingFolder, UpdateSourceTrigger=LostFocus}" Watermark="Folder used to stage output" />
                                            <Button Grid.Column="1" Content="Browse..." Click="BrowseStagingFolder_OnClick" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Additional Remote Path" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedWatchProfile.RemoteSubfolder, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="/ABC or blank to use only the destination base path" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Processing Setup" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ProcessingSetups}"
                                                  SelectedItem="{Binding SelectedProfileProcessingSetup}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProcessingSetupItemViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Destination" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Destinations}"
                                                  SelectedItem="{Binding SelectedProfileDestination}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DestinationItemViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,180,*">
                                        <TextBlock VerticalAlignment="Center" Text="Required Quiet Time (sec)" />
                                        <NumericUpDown Grid.Column="1"
                                                       Width="140"
                                                       HorizontalAlignment="Left"
                                                       FormatString="0"
                                                       Minimum="1"
                                                       Maximum="600"
                                                       Value="{Binding SelectedWatchProfile.StabilityDelaySeconds}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,180,*">
                                        <TextBlock VerticalAlignment="Center" Text="Stability Check Interval (sec)" />
                                        <NumericUpDown Grid.Column="1"
                                                       Width="140"
                                                       HorizontalAlignment="Left"
                                                       FormatString="0"
                                                       Minimum="1"
                                                       Maximum="120"
                                                       Value="{Binding SelectedWatchProfile.StabilityPollingSeconds}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Processing Setups">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Reusable Logic" />
                                <TextBlock Text="Processing Setups" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="Define reusable pre-upload behaviour once, then assign it to any watch profile. Use Default Upload when nothing special is needed, or external scripts for custom processing workflows." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="320,*">
                            <Border Classes="card" Margin="0,0,8,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Processing Setups" FontSize="18" FontWeight="SemiBold" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="subtle" Content="Add" Command="{Binding AddProcessingSetupCommand}" />
                                        <Button Classes="subtle" Content="Remove" Command="{Binding RemoveProcessingSetupCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="Custom Script Source URL" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding CustomScriptSourceUrl, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="Paste one shared customer script link here" />
                                        <Button Grid.Column="1"
                                                Content="Check / Import"
                                                Click="ImportProcessingScriptBundle_OnClick" />
                                    </Grid>
                                    <TextBlock Text="{Binding ProcessingSetupImportStatus}"
                                               TextWrapping="Wrap"
                                               Opacity="0.8" />

                                    <ListBox ItemsSource="{Binding ProcessingSetups}" SelectedItem="{Binding SelectedProcessingSetup}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProcessingSetupItemViewModel">
                                                <StackPanel Margin="0,4,0,4" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Mode}" FontSize="12" Opacity="0.7" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Selected Processing Setup" FontSize="18" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Setup Name" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedProcessingSetup.Name, UpdateSourceTrigger=LostFocus}" Watermark="Mozaik External Script" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Mode" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableProcessingModes}"
                                                  SelectedItem="{Binding SelectedProcessingSetup.Mode}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Runner" />
                                        <ComboBox Grid.Column="1"
                                                  IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                  Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                  ItemsSource="{Binding AvailableRunnerModes}"
                                                  SelectedItem="{Binding SelectedProcessingSetup.RunnerMode}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Script Path" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Grid.Column="0"
                                                     Margin="0,0,8,0"
                                                     IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                     Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                     Text="{Binding SelectedProcessingSetup.ScriptPath, UpdateSourceTrigger=LostFocus}"
                                                     Watermark="/path/to/script.ps1 or script.sh" />
                                            <Button Grid.Column="1"
                                                    Margin="0,0,8,0"
                                                    Content="Browse..."
                                                    IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                    Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                    Click="BrowseProcessingScript_OnClick" />
                                            <Button Grid.Column="2"
                                                    Classes="subtle"
                                                    Content="Open Scripts Folder"
                                                    Click="OpenScriptsFolder_OnClick" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Arguments Template" />
                                        <TextBox Grid.Column="1"
                                                 IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                 Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                 Text="{Binding SelectedProcessingSetup.ArgumentsTemplate, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="&quot;{sourcePath}&quot; &quot;{outputPath}&quot;" />
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Available placeholders" FontWeight="SemiBold" Opacity="0.85" />
                                        <TextBlock Text="{}{sourcePath} - the detected source file or folder" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{}{outputPath} - the prepared output folder for processed files" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{}{scriptPath} - the selected script path" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="Custom scripts are imported once from the shared source on the left, then each processing setup chooses its own local Script Path from the imported folder." Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="Any other text is passed through literally, so you can add extra fixed arguments. Example: &quot;{sourcePath}&quot; &quot;{outputPath}&quot; &quot;watch1&quot; or &quot;{sourcePath}&quot; &quot;{outputPath}&quot; --update-cyc-y." Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="External scripts should exit 0 on success and can optionally print OUTPUT_PATH=/path/to/folder." Opacity="0.75" TextWrapping="Wrap" />

                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Destinations">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Destinations" />
                                <TextBlock Text="Destinations" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="Create reusable destinations here, then assign them to any number of folder watches. Start with FTP, SFTP, SCP, a local folder, or a network share." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="320,*">
                            <Border Classes="card" Margin="0,0,8,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="Destinations"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1"
                                                Classes="subtle"
                                                Content="Add"
                                                Command="{Binding AddDestinationCommand}" />
                                        <Button Grid.Column="2"
                                                Classes="subtle"
                                                Content="Remove"
                                                Command="{Binding RemoveDestinationCommand}" />
                                    </Grid>

                                    <ListBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DestinationItemViewModel">
                                                <StackPanel Margin="0,4,0,4" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding EndpointSummary}" FontSize="12" Opacity="0.7" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Selected Destination" FontSize="18" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Destination Name" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedDestination.Name, UpdateSourceTrigger=LostFocus}" Watermark="Factory Router" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Destination Type" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableDestinationTypes}"
                                                  SelectedItem="{Binding SelectedDestination.Type}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ., Converter={StaticResource DestinationTypeDisplayConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*,Auto"
                                          IsVisible="{Binding SelectedDestination.UsesLocalFolder}">
                                        <TextBlock VerticalAlignment="Center" Text="Local Folder" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedDestination.LocalRootPath, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="/Users/Shared/CNC Output" />
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Content="Browse..."
                                                Click="BrowseDestinationFolder_OnClick" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesNetworkShare}">
                                        <TextBlock VerticalAlignment="Center" Text="Server Host" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedDestination.NetworkHost, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="192.168.1.10 or fileserver.local" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesNetworkShare}">
                                        <TextBlock VerticalAlignment="Center" Text="Share Name" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedDestination.NetworkShareName, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="SharedJobs" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesNetworkShare}">
                                        <TextBlock VerticalAlignment="Center" Text="Domain or Workgroup" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedDestination.NetworkDomain, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="Optional" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,Auto,*"
                                          IsVisible="{Binding SelectedDestination.UsesNetworkShare}">
                                        <TextBlock VerticalAlignment="Center" Text="Use Current User Credentials" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedDestination.UseCurrentUserCredentials}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Classes="muted"
                                                   IsVisible="{Binding SelectedDestination.UseCurrentUserCredentials, Converter={StaticResource BooleanNegationConverter}}"
                                                   Text="If the remote server is a Mac, explicit SMB sign-in may require enabling this account under Windows File Sharing in System Settings > General > Sharing > File Sharing > Options."
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesRemoteHost}">
                                        <TextBlock VerticalAlignment="Center" Text="Host" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedDestination.Host, UpdateSourceTrigger=LostFocus}" Watermark="Hostname or IP address" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Remote Base Path" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedDestination.RemoteBasePath, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="/uploads or blank for the destination root" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,260,*">
                                        <TextBlock VerticalAlignment="Center" Text="Upload Behaviour" />
                                        <CheckBox Grid.Column="1"
                                                  Content="Remove remote folder contents before upload"
                                                  IsChecked="{Binding SelectedDestination.ReplaceRemoteFolderOnUpload}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Classes="muted"
                                                   Text="Only removes the item-specific child folder created for this upload. It never removes the destination base path itself. If this is off, CNC Sync appends into the remote folder and overwrites files only where the same file already exists."
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,260,Auto,*"
                                          IsVisible="{Binding HasSelectedDestination}">
                                        <TextBlock VerticalAlignment="Center" Text="Required VPN" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableVpnConnectionOptions}"
                                                  SelectedItem="{Binding SelectedDestinationVpnOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VpnConnectionOptionViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Classes="subtle"
                                                Content="Refresh VPNs"
                                                Command="{Binding RefreshVpnConnectionsCommand}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Classes="muted"
                                                   Text="Required VPN profiles must be able to connect automatically without prompting for user interaction. Save credentials or use a profile that the OS can bring up unattended."
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,Auto,*"
                                          IsVisible="{Binding SelectedDestination.UsesVpnBehaviorOptions}">
                                        <TextBlock VerticalAlignment="Center" Text="VPN Behavior" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding SelectedDestination.CheckDirectConnectionBeforeVpn}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Classes="muted"
                                                   Text="Before starting the required VPN, first try the destination directly. If it is already reachable on the current network, use it without VPN."
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,Auto,*"
                                          Margin="0,-4,0,0"
                                          IsVisible="{Binding SelectedDestination.UsesVpnBehaviorOptions}">
                                        <TextBlock VerticalAlignment="Center" Text="" />
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding SelectedDestination.DisconnectVpnWhenFinished}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Classes="muted"
                                                   Text="If CNC Sync had to connect the required VPN for this destination, disconnect it when the operation finishes." 
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,180,*"
                                          IsVisible="{Binding SelectedDestination.UsesRemoteHost}">
                                        <TextBlock VerticalAlignment="Center" Text="Port" />
                                        <NumericUpDown Grid.Column="1"
                                                       Width="140"
                                                       HorizontalAlignment="Left"
                                                       FormatString="0"
                                                       Minimum="1"
                                                       Maximum="65535"
                                                       Value="{Binding SelectedDestination.Port}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesSshAuthentication}">
                                        <TextBlock VerticalAlignment="Center" Text="Authentication" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding SelectedDestination.AvailableSshAuthenticationModes}"
                                                  SelectedItem="{Binding SelectedDestination.SshAuthenticationMode}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ., Converter={StaticResource SshAuthenticationModeDisplayConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.SupportsAnonymousFtp}">
                                        <TextBlock VerticalAlignment="Center" Text="Use Anonymous FTP" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedDestination.UseAnonymousFtp}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesUsername}">
                                        <TextBlock VerticalAlignment="Center" Text="Username" />
                                        <TextBox Grid.Column="1"
                                                 IsEnabled="{Binding SelectedDestination.UsernameIsEditable}"
                                                 Opacity="{Binding SelectedDestination.UsernameOpacity}"
                                                 Text="{Binding SelectedDestination.Username, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="Required for SFTP, SCP, network shares, and non-anonymous FTP" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesPassword}">
                                        <TextBlock VerticalAlignment="Center" Text="Password" />
                                        <TextBox Grid.Column="1"
                                                 IsEnabled="{Binding SelectedDestination.PasswordIsEditable}"
                                                 Opacity="{Binding SelectedDestination.PasswordOpacity}"
                                                 PasswordChar="*"
                                                 Text="{Binding SelectedDestination.Password, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="SFTP, SCP, network share, or FTP password" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,260,*"
                                          IsVisible="{Binding SelectedDestination.UsesFtpDataMode}">
                                        <TextBlock VerticalAlignment="Center" Text="FTP Data Mode" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding SelectedDestination.AvailableFtpDataModes}"
                                                  SelectedItem="{Binding SelectedDestination.FtpDataMode}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="core:FtpDataMode">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource FtpDataModeDisplayConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Classes="muted"
                                                   Text="Auto Passive chooses passive negotiation automatically. Passive forces classic PASV. Active asks the server to connect back to this machine. Older CNC FTP servers may work better with Passive or Active if uploads partially succeed and then stall or return 550 errors."
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*,Auto"
                                          IsVisible="{Binding SelectedDestination.UsesPrivateKeyPath}">
                                        <TextBlock VerticalAlignment="Center" Text="Private Key Path" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedDestination.PrivateKeyPath, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="~/.ssh/id_ed25519 or C:\\Users\\you\\.ssh\\id_ed25519" />
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Content="Browse..."
                                                Click="BrowsePrivateKey_OnClick" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*"
                                          IsVisible="{Binding SelectedDestination.UsesPrivateKeyPassphrase}">
                                        <TextBlock VerticalAlignment="Center" Text="Key Passphrase" />
                                        <TextBox Grid.Column="1"
                                                 PasswordChar="*"
                                                 Text="{Binding SelectedDestination.PrivateKeyPassphrase, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="Optional private key passphrase" />
                                    </Grid>

                                    <Button HorizontalAlignment="Left"
                                            Classes="primary"
                                            Content="Test This Destination"
                                            Command="{Binding TestDestinationCommand}" />
                                    <TextBlock Classes="muted"
                                               Text="{Binding DestinationTestStatus}"
                                               TextWrapping="Wrap" />

                                    <Border Classes="card" Padding="16" CornerRadius="14" Margin="0,8,0,0">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Remote Browser" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Classes="muted"
                                                           Text="Open the selected destination and quickly verify what is already there. This works for FTP, SFTP, SCP, local folders, and network shares."
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Grid ColumnDefinitions="220,*">
                                                <TextBlock VerticalAlignment="Center" Text="Current Remote Path" />
                                                <TextBox Grid.Column="1"
                                                         IsReadOnly="True"
                                                         Text="{Binding RemoteBrowserPath}" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Classes="primary"
                                                        Content="Refresh"
                                                        Command="{Binding RefreshRemoteBrowserCommand}" />
                                                <Button Classes="subtle"
                                                        Content="Up"
                                                        Command="{Binding BrowseRemoteParentCommand}" />
                                                <Button Classes="subtle"
                                                        Content="Open Selected Folder"
                                                        Command="{Binding OpenSelectedRemoteFolderCommand}" />
                                                <Button Classes="subtle"
                                                        Content="Delete Selected"
                                                        Command="{Binding DeleteSelectedRemoteItemCommand}" />
                                            </StackPanel>

                                            <TextBlock Classes="muted"
                                                       Text="{Binding RemoteBrowserStatus}"
                                                       TextWrapping="Wrap" />

                                            <ListBox Height="220"
                                                     ItemsSource="{Binding RemoteBrowserItems}"
                                                     SelectedItem="{Binding SelectedRemoteBrowserItem}"
                                                     DoubleTapped="RemoteBrowserList_OnDoubleTapped">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RemoteBrowserItemViewModel">
                                                        <Grid Margin="0,2,0,2" ColumnDefinitions="*,110,140">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="12,0,12,0"
                                                                       Text="{Binding Kind}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SizeDisplay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity">
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                    <TextBlock Classes="muted" Text="Recent events from monitoring, processing, catch-up, and destination activity. Use this tab to trace what happened and when." />
                    <TextBox Grid.Row="1"
                             Margin="0,12,0,0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Menlo, Monaco, Consolas, monospace"
                             Text="{Binding ActivityLogText}" />
                </Grid>
            </TabItem>

            <TabItem Header="Help / About">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Support" />
                                <TextBlock Text="Help / About" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="CNC Sync works best when you set things up in this order: destination, processing setup, watch folder, validation, then monitoring." TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="Made with love by Ben Harper, 3DTek.com.au." TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="subtle"
                                            Content="Open Project Page"
                                            Tag="{Binding ProjectSiteUrl}"
                                            Click="OpenExternalLink_OnClick" />
                                    <Button Classes="subtle"
                                            Content="Open Update Log"
                                            Tag="{Binding ReleaseNotesUrl}"
                                            Click="OpenExternalLink_OnClick" />
                                    <Button Classes="subtle"
                                            Content="Open App Data Folder"
                                            Click="OpenAppData_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Recommended Setup Order" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="1. Create a destination. Start with FTP, SFTP, SCP, Local Folder, or Network Share and confirm it with Test This Destination." TextWrapping="Wrap" />
                                <TextBlock Text="2. Create a processing setup. Use the default copy mode if no transformation is needed, or an external script if files need local preparation first." TextWrapping="Wrap" />
                                <TextBlock Text="3. Create a folder watch and select both the destination and processing setup it should use." TextWrapping="Wrap" />
                                <TextBlock Text="4. Validate settings to catch missing folders, scripts, or broken references." TextWrapping="Wrap" />
                                <TextBlock Text="5. Start monitoring." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Destination Types" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="FTP is the simplest remote option and supports anonymous mode if your server allows it." TextWrapping="Wrap" />
                                <TextBlock Text="SFTP and SCP use SSH. They support username/password or private-key authentication. Private keys can live in your normal .ssh folder." TextWrapping="Wrap" />
                                <TextBlock Text="Local Folder writes to a normal filesystem path. Network Share is for SMB shares and may need OS-level sign-in or mounting depending on the platform." TextWrapping="Wrap" />
                                <TextBlock Text="Remote Base Path is the destination root. A watch profile&apos;s Additional Remote Path is appended underneath it, if set." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="SSH Authentication" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="For SFTP and SCP, choose Password when the server expects a normal login. Choose Private Key when the server expects an SSH key file." TextWrapping="Wrap" />
                                <TextBlock Text="Private Key Path can point at a file such as ~/.ssh/id_ed25519 on macOS or Linux, or C:\Users\you\.ssh\id_ed25519 on Windows. If the key has a passphrase, enter it in Key Passphrase." TextWrapping="Wrap" />
                                <TextBlock Text="Passwords and private-key passphrases are kept out of settings.json and stored using the platform secret store where available." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Network Shares and VPNs" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Network Share currently means SMB. On macOS, explicit username/password access to a Mac server may require enabling that account under Windows File Sharing in System Settings &gt; General &gt; Sharing &gt; File Sharing &gt; Options." TextWrapping="Wrap" />
                                <TextBlock Text="On Linux, Network Share works best with desktop-mounted SMB shares. On Windows, current-user UNC access and explicit SMB sign-in are both supported." TextWrapping="Wrap" />
                                <TextBlock Text="If a destination needs a system-managed VPN first, choose it in Required VPN. CNC Sync will try to connect that VPN before testing, browsing, uploading, or deleting." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="External Script Contract" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="External scripts are run locally. They should exit with code 0 on success and may optionally print OUTPUT_PATH=/path/to/folder if the final upload folder is different from the prepared output path." TextWrapping="Wrap" />
                                <TextBlock Text="Supported argument placeholders: {sourcePath}, {outputPath}, {scriptPath}. Any other text is passed through literally, so you can add extra fixed arguments like &quot;watch1&quot; or --update-cyc-y." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Manual Catch-Up" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Manual catch-up retries items that are still sitting in the local staging folder because a previous upload did not complete successfully." TextWrapping="Wrap" />
                                <TextBlock Text="Scheduled catch-up uses the same staged outbox model. It can only retry items that made it into staging while the app was running, so Launch At Login is recommended if you want fewer missed files." TextWrapping="Wrap" />
                                <TextBlock Text="It cannot detect and reprocess files that were created while CNC Sync was not running and never made it into staging." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Activity and Troubleshooting" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="The Activity tab is selectable, so you can copy log text directly out of the app while testing." TextWrapping="Wrap" />
                                <TextBlock Text="The same activity stream is also written to a text log file under your app-data folder. On macOS that file is ~/Library/Application Support/CNC Sync/activity.log." TextWrapping="Wrap" />
                                <TextBlock Text="Unhandled exceptions and raw diagnostic details are also written beside it as diagnostics.log." TextWrapping="Wrap" />
                                <TextBlock Text="Junk files such as .DS_Store, ._* files, Thumbs.db, desktop.ini, and ehthumbs.db are ignored throughout watching, staging, and uploading." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
