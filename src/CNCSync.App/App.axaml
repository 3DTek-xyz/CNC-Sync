<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:converters="using:CNCSync.App.Converters"
             x:Class="CNCSync.App.App"
             xmlns:local="using:CNCSync.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <converters:BooleanOpacityConverter x:Key="BooleanOpacityConverter" />
        <converters:DestinationTypeDisplayConverter x:Key="DestinationTypeDisplayConverter" />
        <converters:NetworkShareProtocolDisplayConverter x:Key="NetworkShareProtocolDisplayConverter" />
        <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FCFDFE" />
        <SolidColorBrush x:Key="AppCardBorderBrush" Color="#D7E0EA" />
        <SolidColorBrush x:Key="AppHeroBrush" Color="#E9F2FF" />
        <SolidColorBrush x:Key="AppHeroBorderBrush" Color="#B7CDF2" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#1E5BB8" />
        <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#DCE9FF" />
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="#58718B" />
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource AppPageBackgroundBrush}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource AppCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #120F172A" />
        </Style>

        <Style Selector="Border.heroCard">
            <Setter Property="Background" Value="{StaticResource AppHeroBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppHeroBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 10 28 0 #141E5BB8" />
        </Style>

        <Style Selector="TextBlock.sectionEyebrow">
            <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,9" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="{StaticResource AppAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
        </Style>

        <Style Selector="TextBox, ComboBox, NumericUpDown, ListBox">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/cnc-sync-tray.png"
                      controls:MacOSProperties.IsTemplateIcon="False"
                      ToolTipText="CNC Sync"
                      IsVisible="True"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open CNC Sync" Click="OpenMenuItem_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Start Monitoring" Click="StartMonitoringMenuItem_OnClick" />
                        <NativeMenuItem Header="Stop Monitoring" Click="StopMonitoringMenuItem_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Status: Stopped" IsEnabled="False" />
                        <NativeMenuItem Header="-" IsEnabled="False" />
                        <NativeMenuItem Header="-" IsEnabled="False" />
                        <NativeMenuItem Header="-" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" Click="QuitMenuItem_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
