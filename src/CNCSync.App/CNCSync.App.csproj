<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>CNCSync</AssemblyName>
    <ApplicationTitle>ProCut Suite Desktop</ApplicationTitle>
    <ApplicationIcon>Assets\procut-suite.ico</ApplicationIcon>
    <RootNamespace>CNCSync.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64;linux-x64</RuntimeIdentifiers>
    <MacLoginItemBridgeName>libcncsync-login-item-bridge.dylib</MacLoginItemBridgeName>
    <PostHogProjectApiKey Condition="'$(PostHogProjectApiKey)' == ''"></PostHogProjectApiKey>
    <PostHogHostUrl Condition="'$(PostHogHostUrl)' == ''">https://us.i.posthog.com</PostHogHostUrl>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.13" />
    <PackageReference Include="PostHog" Version="2.2.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.13">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CNCSync.Core\CNCSync.Core.csproj" />
    <ProjectReference Include="..\CNCSync.Infrastructure\CNCSync.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PostHogProjectApiKey</_Parameter1>
      <_Parameter2>$(PostHogProjectApiKey)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PostHogHostUrl</_Parameter1>
      <_Parameter2>$(PostHogHostUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\examples\scripts\**\*">
      <Link>BundledScripts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildMacLoginItemBridgeForBuild"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')))">
    <Exec Command="env CLANG_MODULE_CACHE_PATH=&quot;$(IntermediateOutputPath)clang-module-cache&quot; xcrun swiftc -emit-library -framework Foundation -framework ServiceManagement &quot;$(MSBuildProjectDirectory)/MacBridge/bridge.swift&quot; -o &quot;$(TargetDir)$(MacLoginItemBridgeName)&quot;" />
  </Target>

</Project>
