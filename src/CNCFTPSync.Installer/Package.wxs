<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
  <Package Name="CNC-FTP-SYNC"
           Manufacturer="3DTek"
           Version="!(bind.FileVersion.CNCFTPSyncGUI.exe)"
           UpgradeCode="12345678-1234-1234-1234-123456789012"
           Compressed="true"
           InstallerVersion="500">

    <SummaryInformation Description="CNC File Transfer and Processing Service"
                       Manufacturer="3DTek"
                       Keywords="CNC, File Transfer, FTP, G-Code" />

    <!-- Major upgrade configuration for automatic updates -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  AllowDowngrades="no"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />

    <!-- Media and cabinet configuration -->
    <Media Id="1" Cabinet="cbwss.cab" EmbedCab="true" /> 

    <!-- Feature tree -->
    <Feature Id="ProductFeature" Title="CNC-FTP-SYNC Application" Level="1"> 
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="ConfigurationComponents" />
      <ComponentGroupRef Id="LogsComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="UserScriptsComponents" />
      <ComponentRef Id="ProgramMenuDir" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="ServiceManagement" />
    </Feature>

    <!-- WiX UI for installation wizard with license agreement -->
    <ui:WixUI Id="WixUI_InstallDir" />
    
    <!-- Required property for WixUI_InstallDir to link to our install directory -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    
    <!-- License file configuration -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Installation directory structure -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CNC-FTP-SYNC">
        <Directory Id="ConfigFolder" Name="config" />
        <Directory Id="LogsFolder" Name="logs" />
        <Directory Id="UserScriptsFolder" Name="UserScripts" />
      </Directory>
    </StandardDirectory>

    <!-- ProgramData directory for shared configuration -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ProgramDataConfigFolder" Name="CNC-FTP-SYNC" />
    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="CNC-FTP-SYNC" />
    </StandardDirectory>

    <!-- Desktop -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- Program Menu shortcut component -->
    <Component Id="ProgramMenuDir" Directory="ApplicationProgramsFolder" Guid="63C7656D-1982-4335-BC87-F4D390D97EDE">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="CNC-FTP-SYNC"
                Description="CNC File Transfer and Processing Service"
                Target="[INSTALLFOLDER]CNCFTPSyncGUI.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\3DTek\CNC-FTP-SYNC"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut component -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="CE4BC902-0880-4FE6-9763-C8E7BCBD1DB3">
      <Shortcut Id="ApplicationDesktopShortcut"
                Name="CNC-FTP-SYNC"
                Description="CNC File Transfer and Processing Service"
                Target="[INSTALLFOLDER]CNCFTPSyncGUI.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="Software\3DTek\CNC-FTP-SYNC"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Windows Service Management Component - Only manage if service exists -->
    <Component Id="ServiceManagement" Directory="INSTALLFOLDER" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890" Condition="SERVICEEXISTS">
      <!-- Service Control for Updates - Stop existing service before upgrade -->
      <ServiceControl Id="StopServiceOnUpgrade"
                      Name="CNCFTPSyncService"
                      Stop="both"
                      Wait="yes" />
      
      <!-- Service Control for Updates - Start service after upgrade -->
      <ServiceControl Id="StartServiceAfterUpgrade"
                      Name="CNCFTPSyncService"
                      Start="install"
                      Wait="no" />
      
      <!-- Service Control for Uninstall - Stop and remove existing service during uninstall -->
      <ServiceControl Id="StopAndRemoveServiceOnUninstall"
                      Name="CNCFTPSyncService"
                      Stop="uninstall"
                      Remove="uninstall"
                      Wait="yes" />
      
      <!-- Registry key to track service management -->
      <RegistryValue Root="HKLM"
                     Key="Software\3DTek\CNC-FTP-SYNC"
                     Name="ServiceManaged"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Windows Service management for automatic updates -->
    <!-- Service will be installed/updated automatically if already exists -->

    <!-- Properties for silent installation -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    
    <!-- Detect existing service via registry -->
    <Property Id="SERVICEEXISTS">
      <RegistrySearch Id="ServiceExistsSearch"
                      Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\CNCFTPSyncService"
                      Type="raw" />
    </Property>

    <!-- Custom action to launch application after installation -->
    <CustomAction Id="LaunchApplication"
                  Impersonate="yes"
                  Execute="deferred"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]CNCFTPSyncGUI.exe"
                  Return="asyncNoWait" />

    <!-- Install sequence - launch app after installation -->
    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" Before="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

  </Package>


</Wix>