<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <AssemblyTitle>G-Code Sync Windows Service</AssemblyTitle>
    <AssemblyDescription>Windows Service for G-Code file monitoring and FTP synchronization</AssemblyDescription>
    <Copyright>Copyright © 2025</Copyright>
    <Version>1.0.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="**/*.resources.dll" />
  </ItemGroup>

  <Target Name="RemoveUnnecessaryLanguageFolders" AfterTargets="Build">
    <ItemGroup>
      <UnwantedLanguageFolders Include="$(OutputPath)cs" />
      <UnwantedLanguageFolders Include="$(OutputPath)de" />
      <UnwantedLanguageFolders Include="$(OutputPath)es" />
      <UnwantedLanguageFolders Include="$(OutputPath)fr" />
      <UnwantedLanguageFolders Include="$(OutputPath)it" />
      <UnwantedLanguageFolders Include="$(OutputPath)ja" />
      <UnwantedLanguageFolders Include="$(OutputPath)ko" />
      <UnwantedLanguageFolders Include="$(OutputPath)pl" />
      <UnwantedLanguageFolders Include="$(OutputPath)pt-BR" />
      <UnwantedLanguageFolders Include="$(OutputPath)ru" />
      <UnwantedLanguageFolders Include="$(OutputPath)tr" />
      <UnwantedLanguageFolders Include="$(OutputPath)zh-Hans" />
      <UnwantedLanguageFolders Include="$(OutputPath)zh-Hant" />
    </ItemGroup>
    <RemoveDir Directories="@(UnwantedLanguageFolders)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.3.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GCodeSyncCore\GCodeSyncCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\GCodeSyncCore\NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>