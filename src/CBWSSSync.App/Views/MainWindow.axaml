<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CBWSSSync.App.ViewModels"
        xmlns:core="using:CBWSSSync.Core.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CBWSSSync.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/cnc-sync.ico"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="720"
        Title="CNC Sync">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="24">
        <TabControl>
            <TabItem Header="Overview">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionEyebrow" Text="Control Panel" />
                                <TextBlock Text="{Binding AppTitle}" FontSize="28" FontWeight="Bold" />
                                <TextBlock Classes="muted"
                                           Text="Monitor local CNC export folders, optionally process them, and upload the result to FTP."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Classes="heroCard" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="sectionEyebrow" Text="Live Status" />
                                    <TextBlock Text="Monitoring" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MonitoringStatus, StringFormat=Status: {0}}" />
                                    <TextBlock Classes="muted" Text="{Binding ActiveMonitoringProfilesSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentTask, StringFormat=Current task: {0}}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding LastProcessingSummary}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="primary" Content="Start" Command="{Binding StartMonitoringCommand}" />
                                        <Button Classes="subtle" Content="Stop" Command="{Binding StopMonitoringCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="sectionEyebrow" Text="Recovery" />
                                    <TextBlock Text="Manual Catch-Up" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="{Binding ManualActionSummary}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="180,*">
                                        <TextBlock VerticalAlignment="Center" Text="Watch Profile" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WatchProfiles}"
                                                  SelectedItem="{Binding SelectedManualWatchProfile}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WatchProfileItemViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <Button Classes="primary" HorizontalAlignment="Left" Content="Catch Up Missing Files" Command="{Binding ManualProcessCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="App Settings">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sectionEyebrow" Text="Global" />
                                    <TextBlock Text="App Settings" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="These settings affect the whole app. Use this tab for startup behaviour, loading saved settings, and checking whether the current configuration is valid." TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="subtle" Content="Load Settings" Command="{Binding LoadSettingsCommand}" />
                                    <Button Classes="primary" Content="Validate Settings" Command="{Binding ValidateSettingsCommand}" />
                                    <Button Classes="subtle" Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" />
                                    <Button Classes="subtle" Content="Download and Restart" Command="{Binding DownloadAndRestartUpdateCommand}" IsEnabled="{Binding CanApplyUpdate}" />
                                </StackPanel>

                                <TextBlock Classes="muted" Text="{Binding SaveMessage}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="App Behavior" FontSize="18" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="220,*">
                                    <TextBlock VerticalAlignment="Center" Text="Launch At Login" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LaunchAtLogin}" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*">
                                    <TextBlock VerticalAlignment="Center" Text="Start Minimized" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Validation" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
                                </StackPanel>

                                <ListBox Height="160" ItemsSource="{Binding ValidationErrors}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Watch Folders">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Live Rules" />
                                <TextBlock Text="Watch Folders" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="A folder watch is the live rule that watches one local folder, stages output, chooses a processing setup, and uploads to a selected FTP destination." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="320,*">
                            <Border Classes="card" Margin="0,0,8,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Watch Profiles" FontSize="18" FontWeight="SemiBold" />
                                        <Button Classes="subtle" Content="Add" Command="{Binding AddWatchProfileCommand}" />
                                        <Button Classes="subtle" Content="Remove" Command="{Binding RemoveWatchProfileCommand}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding WatchProfiles}" SelectedItem="{Binding SelectedWatchProfile}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WatchProfileItemViewModel">
                                                <StackPanel Margin="0,4,0,4" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding WatchFolder}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Selected Watch Profile" FontSize="18" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Profile Name" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedWatchProfile.Name, UpdateSourceTrigger=LostFocus}" Watermark="Kitchen Router Jobs" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Enabled" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedWatchProfile.Enabled}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Watch Folder" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding SelectedWatchProfile.WatchFolder, UpdateSourceTrigger=LostFocus}" Watermark="Folder to monitor" />
                                            <Button Grid.Column="1" Content="Browse..." Click="BrowseWatchFolder_OnClick" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Staging Folder" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding SelectedWatchProfile.StagingFolder, UpdateSourceTrigger=LostFocus}" Watermark="Folder used to stage output" />
                                            <Button Grid.Column="1" Content="Browse..." Click="BrowseStagingFolder_OnClick" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Remote Subfolder" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedWatchProfile.RemoteSubfolder, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="/ABC or blank for the FTP setup base path" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Processing Setup" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding ProcessingSetups}"
                                                  SelectedItem="{Binding SelectedProfileProcessingSetup}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProcessingSetupItemViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="FTP Destination" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding FtpDestinations}"
                                                  SelectedItem="{Binding SelectedProfileDestination}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FtpDestinationItemViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,180,*">
                                        <TextBlock VerticalAlignment="Center" Text="Required Quiet Time (sec)" />
                                        <NumericUpDown Grid.Column="1"
                                                       Width="140"
                                                       HorizontalAlignment="Left"
                                                       FormatString="0"
                                                       Minimum="1"
                                                       Maximum="600"
                                                       Value="{Binding SelectedWatchProfile.StabilityDelaySeconds}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,180,*">
                                        <TextBlock VerticalAlignment="Center" Text="Stability Check Interval (sec)" />
                                        <NumericUpDown Grid.Column="1"
                                                       Width="140"
                                                       HorizontalAlignment="Left"
                                                       FormatString="0"
                                                       Minimum="1"
                                                       Maximum="120"
                                                       Value="{Binding SelectedWatchProfile.StabilityPollingSeconds}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Processing Setups">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Reusable Logic" />
                                <TextBlock Text="Processing Setups" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="Define reusable pre-upload behaviour once, then assign it to any watch profile. Use Default Upload when nothing special is needed, or external scripts for custom processing workflows." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="320,*">
                            <Border Classes="card" Margin="0,0,8,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock VerticalAlignment="Center" Text="Processing Setups" FontSize="18" FontWeight="SemiBold" />
                                        <Button Classes="subtle" Content="Add" Command="{Binding AddProcessingSetupCommand}" />
                                        <Button Classes="subtle" Content="Remove" Command="{Binding RemoveProcessingSetupCommand}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding ProcessingSetups}" SelectedItem="{Binding SelectedProcessingSetup}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProcessingSetupItemViewModel">
                                                <StackPanel Margin="0,4,0,4" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Mode}" FontSize="12" Opacity="0.7" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Selected Processing Setup" FontSize="18" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Setup Name" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedProcessingSetup.Name, UpdateSourceTrigger=LostFocus}" Watermark="Mozaik External Script" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Mode" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableProcessingModes}"
                                                  SelectedItem="{Binding SelectedProcessingSetup.Mode}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Upload Behaviour" />
                                        <CheckBox Grid.Column="1"
                                                  Content="Replace remote folder contents before upload"
                                                  IsChecked="{Binding SelectedProcessingSetup.ReplaceRemoteFolderOnUpload}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Runner" />
                                        <ComboBox Grid.Column="1"
                                                  IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                  Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                  ItemsSource="{Binding AvailableRunnerModes}"
                                                  SelectedItem="{Binding SelectedProcessingSetup.RunnerMode}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Script Path" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Grid.Column="0"
                                                     Margin="0,0,8,0"
                                                     IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                     Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                     Text="{Binding SelectedProcessingSetup.ScriptPath, UpdateSourceTrigger=LostFocus}"
                                                     Watermark="/path/to/script.ps1 or script.sh" />
                                            <Button Grid.Column="1"
                                                    Margin="0,0,8,0"
                                                    Content="Browse..."
                                                    IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                    Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                    Click="BrowseProcessingScript_OnClick" />
                                            <Button Grid.Column="2"
                                                    Classes="subtle"
                                                    Content="Open Scripts Folder"
                                                    Click="OpenScriptsFolder_OnClick" />
                                        </Grid>
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Arguments Template" />
                                        <TextBox Grid.Column="1"
                                                 IsEnabled="{Binding SelectedProcessingSetup.UsesExternalScript}"
                                                 Opacity="{Binding SelectedProcessingSetup.UsesExternalScript, Converter={StaticResource BooleanOpacityConverter}}"
                                                 Text="{Binding SelectedProcessingSetup.ArgumentsTemplate, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="&quot;{sourcePath}&quot; &quot;{outputPath}&quot;" />
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Available placeholders" FontWeight="SemiBold" Opacity="0.85" />
                                        <TextBlock Text="{}{sourcePath} - the detected source file or folder" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{}{outputPath} - the prepared output folder for processed files" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="{}{scriptPath} - the selected script path" Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="Any other text is passed through literally, so you can add extra fixed arguments. Example: &quot;{sourcePath}&quot; &quot;{outputPath}&quot; &quot;watch1&quot; or &quot;{sourcePath}&quot; &quot;{outputPath}&quot; --update-cyc-y." Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="External scripts should exit 0 on success and can optionally print OUTPUT_PATH=/path/to/folder." Opacity="0.75" TextWrapping="Wrap" />
                                        <TextBlock Text="Replace remote folder contents is most useful for folder-based jobs like SampleJob where each upload should replace the previous revision." Opacity="0.75" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="FTP Servers">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Destinations" />
                                <TextBlock Text="FTP Servers" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="Create reusable FTP destinations here, then assign them to any number of folder watches. This avoids re-entering the same server details repeatedly." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="320,*">
                            <Border Classes="card" Margin="0,0,8,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="FTP Destinations"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1"
                                                Classes="subtle"
                                                Content="Add"
                                                Command="{Binding AddFtpDestinationCommand}" />
                                        <Button Grid.Column="2"
                                                Classes="subtle"
                                                Content="Remove"
                                                Command="{Binding RemoveFtpDestinationCommand}" />
                                    </Grid>

                                    <ListBox ItemsSource="{Binding FtpDestinations}" SelectedItem="{Binding SelectedFtpDestination}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FtpDestinationItemViewModel">
                                                <StackPanel Margin="0,4,0,4" Spacing="2">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Host}" FontSize="12" Opacity="0.7" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Grid.Column="1" Margin="8,0,0,0" Padding="18" CornerRadius="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Selected FTP Destination" FontSize="18" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Destination Name" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedFtpDestination.Name, UpdateSourceTrigger=LostFocus}" Watermark="Factory Router" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="FTP Host" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedFtpDestination.Host, UpdateSourceTrigger=LostFocus}" Watermark="Hostname or IP address" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Remote Base Path" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedFtpDestination.RemoteBasePath, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="/uploads or blank for FTP root" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,180,*">
                                        <TextBlock VerticalAlignment="Center" Text="FTP Port" />
                                        <NumericUpDown Grid.Column="1"
                                                       Width="140"
                                                       HorizontalAlignment="Left"
                                                       FormatString="0"
                                                       Minimum="1"
                                                       Maximum="65535"
                                                       Value="{Binding SelectedFtpDestination.Port}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Use Anonymous FTP" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedFtpDestination.UseAnonymousFtp}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="FTP Username" />
                                        <TextBox Grid.Column="1"
                                                 IsEnabled="{Binding SelectedFtpDestination.UseAnonymousFtp, Converter={StaticResource BooleanNegationConverter}}"
                                                 Opacity="{Binding SelectedFtpDestination.UseAnonymousFtp, Converter={StaticResource BooleanOpacityConverter}}"
                                                 Text="{Binding SelectedFtpDestination.Username, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="Required if anonymous access is off" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="FTP Password" />
                                        <TextBox Grid.Column="1"
                                                 IsEnabled="{Binding SelectedFtpDestination.UseAnonymousFtp, Converter={StaticResource BooleanNegationConverter}}"
                                                 Opacity="{Binding SelectedFtpDestination.UseAnonymousFtp, Converter={StaticResource BooleanOpacityConverter}}"
                                                 PasswordChar="*"
                                                 Text="{Binding SelectedFtpDestination.Password, UpdateSourceTrigger=LostFocus}"
                                                 Watermark="FTP password" />
                                    </Grid>

                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock VerticalAlignment="Center" Text="Auto Upload" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedFtpDestination.AutoUpload}" />
                                    </Grid>

                                    <Button HorizontalAlignment="Left"
                                            Classes="primary"
                                            Content="Test This FTP Setup"
                                            Command="{Binding TestFtpCommand}" />

                                    <Border Classes="card" Padding="16" CornerRadius="14" Margin="0,8,0,0">
                                        <StackPanel Spacing="10">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Remote Browser" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Classes="muted"
                                                           Text="Open the selected FTP server and quickly verify what is on the remote path. This is intentionally lightweight: browse, refresh, and delete if needed."
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Grid ColumnDefinitions="220,*">
                                                <TextBlock VerticalAlignment="Center" Text="Current Remote Path" />
                                                <TextBox Grid.Column="1"
                                                         IsReadOnly="True"
                                                         Text="{Binding RemoteBrowserPath}" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Classes="primary"
                                                        Content="Refresh"
                                                        Command="{Binding RefreshRemoteBrowserCommand}" />
                                                <Button Classes="subtle"
                                                        Content="Up"
                                                        Command="{Binding BrowseRemoteParentCommand}" />
                                                <Button Classes="subtle"
                                                        Content="Open Selected Folder"
                                                        Command="{Binding OpenSelectedRemoteFolderCommand}" />
                                                <Button Classes="subtle"
                                                        Content="Delete Selected"
                                                        Command="{Binding DeleteSelectedRemoteItemCommand}" />
                                            </StackPanel>

                                            <TextBlock Classes="muted"
                                                       Text="{Binding RemoteBrowserStatus}"
                                                       TextWrapping="Wrap" />

                                            <ListBox Height="220"
                                                     ItemsSource="{Binding RemoteBrowserItems}"
                                                     SelectedItem="{Binding SelectedRemoteBrowserItem}"
                                                     DoubleTapped="RemoteBrowserList_OnDoubleTapped">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RemoteBrowserItemViewModel">
                                                        <Grid Margin="0,2,0,2" ColumnDefinitions="*,110,140">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="12,0,12,0"
                                                                       Text="{Binding Kind}" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SizeDisplay}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity">
                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                    <TextBlock Classes="muted" Text="Recent events from monitoring, processing, catch-up, and FTP activity. Use this tab to trace what happened and when." />
                    <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding ActivityItems}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ActivityLogEntry">
                                <Grid Margin="0,2,0,2" ColumnDefinitions="90,220,*">
                                    <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontFamily="Menlo, Monaco, Consolas, monospace" Opacity="0.75" />
                                    <TextBlock Grid.Column="1" Margin="12,0,12,0" Text="{Binding SourceDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Help">
                <ScrollViewer Margin="0,12,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0" Spacing="16">
                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionEyebrow" Text="Support" />
                                <TextBlock Text="Getting Started" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="CNC Sync works best when you set things up in this order: FTP setup, processing setup, folder watch, validation, then monitoring." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Recommended Setup Order" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="1. Create an FTP setup with the correct host, port, login, and optional remote base path." TextWrapping="Wrap" />
                                <TextBlock Text="2. Create a processing setup. Use the default copy mode if no transformation is needed, or an external script if files need local preparation first." TextWrapping="Wrap" />
                                <TextBlock Text="3. Create a folder watch and select both the FTP setup and processing setup it should use." TextWrapping="Wrap" />
                                <TextBlock Text="4. Validate settings to catch missing folders, scripts, or broken references." TextWrapping="Wrap" />
                                <TextBlock Text="5. Start monitoring." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="External Script Contract" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="External scripts are run locally. They should exit with code 0 on success and may optionally print OUTPUT_PATH=/path/to/folder if the final upload folder is different from the prepared output path." TextWrapping="Wrap" />
                                <TextBlock Text="Supported argument placeholders: {sourcePath}, {outputPath}, {scriptPath}. Any other text is passed through literally, so you can add extra fixed arguments like &quot;watch1&quot; or --update-cyc-y." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18" CornerRadius="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Manual Catch-Up" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Manual catch-up checks the selected watch profile against the configured FTP path and only processes/uploads missing or changed items. For files, it compares name plus file size." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
